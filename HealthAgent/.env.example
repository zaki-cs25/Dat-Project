# Copy to .env and configure your chat and embedding providers.
#
# IRIS embeds independently of the chat provider; override its settings below.
# The Python sidecar uses it for OpenAI chat unless CP_LLM_API_KEY overrides it.
# No reranker service is required.

# --- Default OpenAI credentials (optional when using your own services) -----
OPENAI_API_KEY=

# --- Embeddings: selected independently of the chat LLM --------------------
# openai (native default), openai_compatible (/embeddings), or ollama (/api/embed).
CP_EMBEDDING_PROVIDER=openai_compatible
CP_EMBEDDING_MODEL=gpustack/bge-m3-GGUF:Q8_0
# API root, e.g. http://your-embedding-server:8080/v1; Ollama uses its root without /api.
CP_EMBEDDING_BASE_URL=http://host.docker.internal:8081/v1
# Falls back to OPENAI_API_KEY except for Ollama; local-placeholder for an unauthenticated compatible server.
CP_EMBEDDING_API_KEY=local-placeholder
# Set this to the model's actual output size (e.g. 384, 768, 1024, 1536).
CP_EMBEDDING_DIMENSIONS=1024
# Send the optional dimensions field only if the endpoint/model supports it.
CP_EMBEDDING_SEND_DIMENSIONS=false
# Bump if you replace weights under the same model name/URL. Model changes require reindexing.
CP_EMBEDDING_REVISION=

# --- Optional: which model the sidecar uses for chat ------------------------
CP_LLM_PROVIDER=openai
CP_OPENAI_MODEL=Qwen3.6-27B

# --- Optional: OpenAI-compatible chat endpoint -----------------------------
# Keep CP_LLM_PROVIDER=openai. Supply the API root, usually ending in /v1,
# not the full /chat/completions path. These settings apply only to chat.
CP_OPENAI_BASE_URL=http://host.docker.internal:9000/v1
CP_LLM_API_KEY=local-placeholder
# Set CP_LLM_API_KEY=local-placeholder for an endpoint that needs no authentication.
# If JSON mode is unsupported, set false; application validation still runs.
CP_OPENAI_JSON_MODE=true
# Compatible servers may expect max_tokens instead of max_completion_tokens.
CP_OPENAI_TOKEN_LIMIT_PARAM=max_tokens
# Optional llama.cpp template settings; leave default for other providers.
# For Gemma drafts whose thinking exhausts the limit, use {"enable_thinking":false}.
CP_OPENAI_CHAT_TEMPLATE_KWARGS={}

# Model knowledge is allowed; ICMR passages enrich context rather than gate recommendations.
# Use grounded only for the earlier passage-constrained comparison.
CP_CARE_GENERATION_MODE=enriched
CP_CARE_CONTEXT_MAX_CHARS=24000
# Complete model-input character bound; server separately enforces token capacity.
CP_MODEL_INPUT_MAX_CHARS=120000
# Enable only with the isolated benchmark database override.
CP_BENCHMARK_API_ENABLED=false

# Serving identity and measurement policy. Unknown sampling uses the server default.
CP_LLM_BACKEND=vllm
CP_LLM_TIMEOUT_SECONDS=60
CP_LLM_MAX_RETRIES=1
CP_LLM_RETRY_BACKOFF_SECONDS=0.5
# Internal streaming still returns a fully assembled/validated product response.
CP_LLM_STREAM=false
CP_LLM_TEMPERATURE=
CP_LLM_TOP_P=
CP_LLM_SEED=
CP_LLM_MAX_OUTPUT_TOKENS=2048
# Declare only verified metadata for the active server; update when changing models.
CP_SERVING_METADATA={}
CP_SERVING_METRICS_URL=http://host.docker.internal:9000/metrics
CP_EMBEDDING_METRICS_URL=http://host.docker.internal:8081/metrics
# Optional node/DCGM exporter on the serving host. Empty means collector-local readings.
CP_HOST_METRICS_URL=

# --- Optional: Anthropic instead of OpenAI for chat -------------------------
# Embeddings use the independent CP_EMBEDDING_* configuration.
# Set CP_LLM_PROVIDER=anthropic to switch.
ANTHROPIC_API_KEY=
CP_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: Ollama for offline chat (experimental) -----------------------
# Set CP_LLM_PROVIDER=ollama and enable the bundled Ollama service with:
#   docker compose --profile ollama up
# Known issue: llama.cpp can crash mid-inference on Apple Silicon Docker
# Desktop. Linux x86 hosts are reliable.
CP_OLLAMA_BASE_URL=http://ollama:11434
CP_OLLAMA_MODEL=llama3.2:3b

# --- IRIS endpoints (defaults match docker-compose service names) -----------
CP_FHIR_BASE_URL=http://iris:52773/csp/healthshare/centralpark/fhir/r4
CP_FHIR_USER=_SYSTEM
CP_FHIR_PASSWORD=SYS
CP_IRIS_REST_BASE_URL=http://iris:52773/centralpark

IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS

# Private corpus directory (excluded from Git and Docker build contexts)
CP_CARE_DOCUMENT_DIR=./md_care_documents
# Inside the agent container; only reviewed/enabled catalogue entries are used.
CP_CARE_CATALOGUE_PATH=/app/md_care_documents/.preparation/catalogue.json
# Host port for agent health/API access; change if another local service uses 8001.
CP_AGENT_PORT=8001
